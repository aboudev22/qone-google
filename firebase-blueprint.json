{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil utilisateur privé rattaché à un compte Google Firebase Auth.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Identifiant Firebase Auth."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200,
          "description": "Adresse email vérifiée de l'utilisateur."
        },
        "firstName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Prénom affiché dans l'ERP."
        },
        "lastName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100,
          "description": "Nom affiché dans l'ERP."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "firstName", "lastName", "createdAt", "updatedAt"]
    },
    "UserMembership": {
      "title": "UserMembership",
      "description": "Index des espaces d'entreprise accessibles par l'utilisateur.",
      "type": "object",
      "properties": {
        "companyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "companyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "companySlug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "role": {
          "type": "string",
          "enum": ["owner", "admin", "member"]
        },
        "enabledModules": {
          "type": "array"
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["companyId", "companyName", "companySlug", "role", "enabledModules", "joinedAt", "updatedAt"]
    },
    "Company": {
      "title": "Company",
      "description": "Espace de travail d'une entreprise isolant ses données ERP.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "memberUids": {
          "type": "array"
        },
        "enabledModules": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "slug", "ownerUid", "memberUids", "enabledModules", "createdAt", "updatedAt"]
    },
    "CompanyMember": {
      "title": "CompanyMember",
      "description": "Collaborateur rattaché à une entreprise avec son rôle RBAC.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "companyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "firstName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "lastName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["owner", "admin", "member"]
        },
        "memberUids": {
          "type": "array"
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "companyId", "email", "firstName", "lastName", "role", "memberUids", "joinedAt", "updatedAt"]
    },
    "Invitation": {
      "title": "Invitation",
      "description": "Invitation nominative à rejoindre une entreprise.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "companyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "companyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "firstName": {
          "type": "string",
          "maxLength": 100
        },
        "lastName": {
          "type": "string",
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["owner", "admin", "member"]
        },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "revoked"]
        },
        "invitedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "memberUids": {
          "type": "array"
        },
        "expiresAt": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "companyId", "companyName", "email", "firstName", "lastName", "role", "status", "invitedByUid", "memberUids", "expiresAt", "createdAt", "updatedAt"]
    },
    "Client": {
      "title": "Client",
      "description": "Fiche client CRM rattachée à une entreprise.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "companyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "email": {
          "type": "string",
          "maxLength": 200
        },
        "phone": {
          "type": "string",
          "maxLength": 60
        },
        "companyName": {
          "type": "string",
          "maxLength": 160
        },
        "status": {
          "type": "string",
          "enum": ["active", "prospect", "inactive"]
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "memberUids": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "companyId", "name", "email", "phone", "companyName", "status", "notes", "createdByUid", "memberUids", "createdAt", "updatedAt"]
    },
    "Opportunity": {
      "title": "Opportunity",
      "description": "Opportunité commerciale du pipeline de ventes.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "companyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "clientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "clientName": {
          "type": "string",
          "maxLength": 160
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "amount": {
          "type": "number"
        },
        "probability": {
          "type": "number"
        },
        "stage": {
          "type": "string",
          "enum": ["prospecting", "qualification", "proposal", "negotiation", "won", "lost"]
        },
        "expectedCloseDate": {
          "type": "string",
          "maxLength": 32
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "ownerUserId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "maxLength": 160
        },
        "memberUids": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "companyId", "clientId", "clientName", "title", "amount", "probability", "stage", "expectedCloseDate", "notes", "ownerUserId", "ownerName", "memberUids", "createdAt", "updatedAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Journal des actions récentes effectuées dans l'espace d'entreprise.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "companyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "memberUids": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "companyId", "actorUid", "actorName", "action", "summary", "memberUids", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Profil privé de l'utilisateur authentifié."
    },
    "/users/{userId}/memberships/{companyId}": {
      "schema": { "$ref": "#/entities/UserMembership" },
      "description": "Entreprises auxquelles l'utilisateur appartient."
    },
    "/companies/{companyId}": {
      "schema": { "$ref": "#/entities/Company" },
      "description": "Espace d'entreprise isolé."
    },
    "/companies/{companyId}/members/{memberUid}": {
      "schema": { "$ref": "#/entities/CompanyMember" },
      "description": "Collaborateurs d'une entreprise."
    },
    "/invitations/{inviteId}": {
      "schema": { "$ref": "#/entities/Invitation" },
      "description": "Invitations d'équipe nominatives."
    },
    "/companies/{companyId}/clients/{clientId}": {
      "schema": { "$ref": "#/entities/Client" },
      "description": "Fiches clients CRM de l'entreprise."
    },
    "/companies/{companyId}/opportunities/{opportunityId}": {
      "schema": { "$ref": "#/entities/Opportunity" },
      "description": "Opportunités commerciales de l'entreprise."
    },
    "/companies/{companyId}/activities/{activityId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Historique des actions de l'entreprise."
    }
  }
}
