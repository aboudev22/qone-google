{
  "name": "erp-qone",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm --workspace=frontend run build",
    "build:frontend": "npm --workspace=frontend run build",
    "build:gh-pages": "npm --workspace=frontend run build && cp frontend/dist/index.html frontend/dist/404.html",
    "lint": "npm --workspace=frontend run lint",
    "start": "NODE_ENV=production tsx server.ts"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "express": "^5.3.0",
    "tsx": "^4.23.15",
    "xlsx": "^0.18.5"
  }
}
