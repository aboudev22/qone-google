rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwnerSelf(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidUserEmailMatch(targetEmail) {
      return request.auth.token.email is string &&
        targetEmail is string &&
        request.auth.token.email.lower() == targetEmail.lower();
    }

    function isMemberUidsList(list) {
      return list is list &&
        list.size() >= 1 &&
        list.size() <= 25 &&
        list[0] is string;
    }

    function isValidRole(role) {
      return role in ['owner', 'admin', 'member'];
    }

    function isValidModules(mods) {
      return mods is list &&
        mods.size() <= 2 &&
        mods.hasOnly(['crm', 'sales']);
    }

    function isCompanyMember(companyId) {
      return isVerifiedUser() &&
        exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid));
    }

    function getCompanyMemberRole(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)).data.role;
    }

    function isCompanyAdmin(companyId) {
      return isCompanyMember(companyId) &&
        getCompanyMemberRole(companyId) in ['owner', 'admin'];
    }

    function isCompanyOwner(companyId) {
      return isCompanyMember(companyId) &&
        getCompanyMemberRole(companyId) == 'owner';
    }

    // 3. Entity Validation Blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'firstName', 'lastName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'firstName', 'lastName', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.firstName is string && data.firstName.size() >= 1 && data.firstName.size() <= 100 &&
        data.lastName is string && data.lastName.size() <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserMembership(data, companyId) {
      return data.keys().hasAll(['companyId', 'companyName', 'companySlug', 'role', 'enabledModules', 'joinedAt', 'updatedAt']) &&
        data.keys().hasOnly(['companyId', 'companyName', 'companySlug', 'role', 'enabledModules', 'joinedAt', 'updatedAt']) &&
        isValidId(data.companyId) &&
        data.companyId == companyId &&
        data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 140 &&
        data.companySlug is string && data.companySlug.size() >= 1 && data.companySlug.size() <= 140 &&
        isValidRole(data.role) &&
        isValidModules(data.enabledModules) &&
        data.joinedAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCompany(data, companyId) {
      return data.keys().hasAll(['id', 'name', 'slug', 'ownerUid', 'memberUids', 'enabledModules', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'slug', 'ownerUid', 'memberUids', 'enabledModules', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.id == companyId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 140 &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 140 &&
        isValidId(data.ownerUid) &&
        isMemberUidsList(data.memberUids) &&
        isValidModules(data.enabledModules) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCompanyMember(data, companyId, memberUid) {
      return data.keys().hasAll(['uid', 'companyId', 'email', 'firstName', 'lastName', 'role', 'memberUids', 'joinedAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'companyId', 'email', 'firstName', 'lastName', 'role', 'memberUids', 'joinedAt', 'updatedAt', 'inviteToken']) &&
        isValidId(data.uid) &&
        data.uid == memberUid &&
        isValidId(data.companyId) &&
        data.companyId == companyId &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.firstName is string && data.firstName.size() >= 1 && data.firstName.size() <= 100 &&
        data.lastName is string && data.lastName.size() <= 100 &&
        isValidRole(data.role) &&
        isMemberUidsList(data.memberUids) &&
        (!('inviteToken' in data) || isValidId(data.inviteToken)) &&
        data.joinedAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidInvitation(data, inviteId) {
      return data.keys().hasAll(['id', 'companyId', 'companyName', 'email', 'firstName', 'lastName', 'role', 'status', 'invitedByUid', 'memberUids', 'expiresAt', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'companyId', 'companyName', 'email', 'firstName', 'lastName', 'role', 'status', 'invitedByUid', 'memberUids', 'expiresAt', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.id == inviteId &&
        isValidId(data.companyId) &&
        data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 140 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.firstName is string && data.firstName.size() <= 100 &&
        data.lastName is string && data.lastName.size() <= 100 &&
        isValidRole(data.role) &&
        data.status in ['pending', 'accepted', 'revoked'] &&
        isValidId(data.invitedByUid) &&
        isMemberUidsList(data.memberUids) &&
        data.expiresAt is string && data.expiresAt.size() >= 10 && data.expiresAt.size() <= 64 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidClient(data, companyId, clientId) {
      return data.keys().hasAll(['id', 'companyId', 'name', 'email', 'phone', 'companyName', 'status', 'notes', 'createdByUid', 'memberUids', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'companyId', 'name', 'email', 'phone', 'companyName', 'status', 'notes', 'createdByUid', 'memberUids', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.id == clientId &&
        isValidId(data.companyId) &&
        data.companyId == companyId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 160 &&
        data.email is string && data.email.size() <= 200 &&
        data.phone is string && data.phone.size() <= 60 &&
        data.companyName is string && data.companyName.size() <= 160 &&
        data.status in ['active', 'prospect', 'inactive'] &&
        data.notes is string && data.notes.size() <= 2000 &&
        isValidId(data.createdByUid) &&
        isMemberUidsList(data.memberUids) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOpportunity(data, companyId, oppId) {
      return data.keys().hasAll(['id', 'companyId', 'clientId', 'clientName', 'title', 'amount', 'probability', 'stage', 'expectedCloseDate', 'notes', 'ownerUserId', 'ownerName', 'memberUids', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'companyId', 'clientId', 'clientName', 'title', 'amount', 'probability', 'stage', 'expectedCloseDate', 'notes', 'ownerUserId', 'ownerName', 'memberUids', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.id == oppId &&
        isValidId(data.companyId) &&
        data.companyId == companyId &&
        isValidId(data.clientId) &&
        data.clientName is string && data.clientName.size() <= 160 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 180 &&
        data.amount is number && data.amount >= 0 && data.amount <= 1000000000 &&
        data.probability is number && data.probability >= 0 && data.probability <= 100 &&
        data.stage in ['prospecting', 'qualification', 'proposal', 'negotiation', 'won', 'lost'] &&
        data.expectedCloseDate is string && data.expectedCloseDate.size() <= 32 &&
        data.notes is string && data.notes.size() <= 2000 &&
        isValidId(data.ownerUserId) &&
        data.ownerName is string && data.ownerName.size() <= 160 &&
        isMemberUidsList(data.memberUids) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidActivity(data, companyId, activityId) {
      return data.keys().hasAll(['id', 'companyId', 'actorUid', 'actorName', 'action', 'summary', 'memberUids', 'createdAt']) &&
        data.keys().hasOnly(['id', 'companyId', 'actorUid', 'actorName', 'action', 'summary', 'memberUids', 'createdAt']) &&
        isValidId(data.id) &&
        data.id == activityId &&
        isValidId(data.companyId) &&
        data.companyId == companyId &&
        isValidId(data.actorUid) &&
        data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 160 &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 64 &&
        data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 300 &&
        isMemberUidsList(data.memberUids) &&
        data.createdAt is timestamp;
    }

    // 4. Collection Rules
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwnerSelf(userId);
      allow list: if isVerifiedUser() && existing().uid == request.auth.uid;
      allow create: if isValidId(userId) &&
        isOwnerSelf(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) &&
        isOwnerSelf(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['firstName', 'lastName', 'email', 'updatedAt']);
      allow delete: if false;

      match /memberships/{companyId} {
        allow get: if isValidId(userId) && isValidId(companyId) &&
          (isOwnerSelf(userId) || isCompanyAdmin(companyId));
        allow list: if isOwnerSelf(userId);
        allow create: if isValidId(userId) && isValidId(companyId) &&
          isVerifiedUser() &&
          isValidUserMembership(incoming(), companyId) &&
          incoming().joinedAt == request.time &&
          incoming().updatedAt == request.time &&
          (isOwnerSelf(userId) || isCompanyAdmin(companyId)) &&
          getAfter(/databases/$(database)/documents/companies/$(companyId)/members/$(userId)).data.role == incoming().role;
        allow update: if isValidId(userId) && isValidId(companyId) &&
          isVerifiedUser() &&
          isValidUserMembership(incoming(), companyId) &&
          incoming().companyId == existing().companyId &&
          incoming().joinedAt == existing().joinedAt &&
          incoming().updatedAt == request.time &&
          isCompanyAdmin(companyId) &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['companyName', 'companySlug', 'enabledModules', 'updatedAt']) ||
            (incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt']) &&
              (incoming().role != 'owner' || isCompanyOwner(companyId)))
          );
        allow delete: if isValidId(userId) && isValidId(companyId) &&
          (isOwnerSelf(userId) || isCompanyAdmin(companyId));
      }
    }

    match /companies/{companyId} {
      allow get: if isValidId(companyId) && isCompanyMember(companyId);
      allow list: if isVerifiedUser() && (request.auth.uid in existing().memberUids);
      allow create: if isValidId(companyId) &&
        isVerifiedUser() &&
        isValidCompany(incoming(), companyId) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().memberUids.size() == 1 &&
        request.auth.uid in incoming().memberUids &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid));
      allow update: if isValidId(companyId) &&
        isVerifiedUser() &&
        isValidCompany(incoming(), companyId) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (isCompanyAdmin(companyId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slug', 'enabledModules', 'memberUids', 'updatedAt'])) ||
          (!(request.auth.uid in existing().memberUids) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']) &&
            incoming().memberUids.hasAll(existing().memberUids) &&
            incoming().memberUids.size() == existing().memberUids.size() + 1 &&
            request.auth.uid in incoming().memberUids &&
            getAfter(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)).data.uid == request.auth.uid)
        );
      allow delete: if isValidId(companyId) && isCompanyOwner(companyId);

      match /members/{memberUid} {
        allow get: if isValidId(companyId) && isValidId(memberUid) && isCompanyMember(companyId);
        allow list: if isVerifiedUser() && (request.auth.uid in existing().memberUids);
        allow create: if isValidId(companyId) && isValidId(memberUid) &&
          isVerifiedUser() &&
          isValidCompanyMember(incoming(), companyId, memberUid) &&
          request.auth.uid in incoming().memberUids &&
          incoming().joinedAt == request.time &&
          incoming().updatedAt == request.time &&
          (
            (memberUid == request.auth.uid &&
              incoming().role == 'owner' &&
              getAfter(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid == request.auth.uid) ||
            (isCompanyAdmin(companyId) &&
              (incoming().role != 'owner' || isCompanyOwner(companyId))) ||
            (memberUid == request.auth.uid &&
              ('inviteToken' in incoming()) &&
              get(/databases/$(database)/documents/invitations/$(incoming().inviteToken)).data.status == 'pending' &&
              get(/databases/$(database)/documents/invitations/$(incoming().inviteToken)).data.companyId == companyId &&
              get(/databases/$(database)/documents/invitations/$(incoming().inviteToken)).data.role == incoming().role &&
              isValidUserEmailMatch(get(/databases/$(database)/documents/invitations/$(incoming().inviteToken)).data.email) &&
              getAfter(/databases/$(database)/documents/invitations/$(incoming().inviteToken)).data.status == 'accepted')
          );
        allow update: if isValidId(companyId) && isValidId(memberUid) &&
          isCompanyAdmin(companyId) &&
          isValidCompanyMember(incoming(), companyId, memberUid) &&
          incoming().uid == existing().uid &&
          incoming().companyId == existing().companyId &&
          incoming().joinedAt == existing().joinedAt &&
          incoming().updatedAt == request.time &&
          (
            (memberUid != request.auth.uid &&
              (existing().role != 'owner' || isCompanyOwner(companyId)) &&
              (incoming().role != 'owner' || isCompanyOwner(companyId)) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt'])) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
          );
        allow delete: if isValidId(companyId) && isValidId(memberUid) &&
          isCompanyAdmin(companyId) &&
          memberUid != request.auth.uid &&
          (existing().role != 'owner' || isCompanyOwner(companyId));
      }

      match /clients/{clientId} {
        allow get: if isValidId(companyId) && isValidId(clientId) && isCompanyMember(companyId);
        allow list: if isVerifiedUser() && (request.auth.uid in existing().memberUids);
        allow create: if isValidId(companyId) && isValidId(clientId) &&
          isCompanyMember(companyId) &&
          isValidClient(incoming(), companyId, clientId) &&
          incoming().createdByUid == request.auth.uid &&
          request.auth.uid in incoming().memberUids &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(companyId) && isValidId(clientId) &&
          isCompanyMember(companyId) &&
          isValidClient(incoming(), companyId, clientId) &&
          incoming().id == existing().id &&
          incoming().companyId == existing().companyId &&
          incoming().createdByUid == existing().createdByUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'phone', 'companyName', 'status', 'notes', 'updatedAt']) ||
            (isCompanyAdmin(companyId) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']))
          );
        allow delete: if isValidId(companyId) && isValidId(clientId) && isCompanyMember(companyId);
      }

      match /opportunities/{opportunityId} {
        allow get: if isValidId(companyId) && isValidId(opportunityId) && isCompanyMember(companyId);
        allow list: if isVerifiedUser() && (request.auth.uid in existing().memberUids);
        allow create: if isValidId(companyId) && isValidId(opportunityId) &&
          isCompanyMember(companyId) &&
          isValidOpportunity(incoming(), companyId, opportunityId) &&
          incoming().ownerUserId == request.auth.uid &&
          request.auth.uid in incoming().memberUids &&
          exists(/databases/$(database)/documents/companies/$(companyId)/clients/$(incoming().clientId)) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(companyId) && isValidId(opportunityId) &&
          isCompanyMember(companyId) &&
          isValidOpportunity(incoming(), companyId, opportunityId) &&
          incoming().id == existing().id &&
          incoming().companyId == existing().companyId &&
          incoming().ownerUserId == existing().ownerUserId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['clientId', 'clientName', 'title', 'amount', 'probability', 'stage', 'expectedCloseDate', 'notes', 'updatedAt']) ||
            (isCompanyAdmin(companyId) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']))
          );
        allow delete: if isValidId(companyId) && isValidId(opportunityId) && isCompanyMember(companyId);
      }

      match /activities/{activityId} {
        allow get: if isValidId(companyId) && isValidId(activityId) && isCompanyMember(companyId);
        allow list: if isVerifiedUser() && (request.auth.uid in existing().memberUids);
        allow create: if isValidId(companyId) && isValidId(activityId) &&
          isCompanyMember(companyId) &&
          isValidActivity(incoming(), companyId, activityId) &&
          incoming().actorUid == request.auth.uid &&
          request.auth.uid in incoming().memberUids &&
          incoming().createdAt == request.time;
        allow update: if isValidId(companyId) && isValidId(activityId) &&
          isCompanyAdmin(companyId) &&
          isValidActivity(incoming(), companyId, activityId) &&
          incoming().id == existing().id &&
          incoming().companyId == existing().companyId &&
          incoming().actorUid == existing().actorUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['memberUids']);
        allow delete: if isValidId(companyId) && isValidId(activityId) && isCompanyOwner(companyId);
      }
    }

    match /invitations/{inviteId} {
      allow get: if isValidId(inviteId) && isVerifiedUser() &&
        (isValidUserEmailMatch(existing().email) ||
         request.auth.uid in existing().memberUids ||
         isCompanyAdmin(existing().companyId));
      allow list: if isVerifiedUser() &&
        (request.auth.uid in existing().memberUids ||
         isValidUserEmailMatch(existing().email));
      allow create: if isValidId(inviteId) &&
        isVerifiedUser() &&
        isValidInvitation(incoming(), inviteId) &&
        isCompanyAdmin(incoming().companyId) &&
        incoming().invitedByUid == request.auth.uid &&
        request.auth.uid in incoming().memberUids &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(inviteId) &&
        isVerifiedUser() &&
        isValidInvitation(incoming(), inviteId) &&
        existing().status == 'pending' &&
        incoming().id == existing().id &&
        incoming().companyId == existing().companyId &&
        incoming().email == existing().email &&
        incoming().invitedByUid == existing().invitedByUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (isCompanyAdmin(existing().companyId) &&
            incoming().status == 'revoked' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
          (isValidUserEmailMatch(existing().email) &&
            incoming().status == 'accepted' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
            existsAfter(/databases/$(database)/documents/companies/$(existing().companyId)/members/$(request.auth.uid)))
        );
      allow delete: if isValidId(inviteId) && isVerifiedUser() && isCompanyAdmin(existing().companyId);
    }
  }
}
